{
  "entities": {
    "CustomerProfile": {
      "title": "CustomerProfile",
      "description": "Authenticated customer contact profile stored to pre-fill quotes and bookings and isolate customer PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the customer.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Customer full name.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Customer email address.",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "description": "Customer phone number.",
          "minLength": 7,
          "maxLength": 30
        },
        "address": {
          "type": "string",
          "description": "Default service street address.",
          "maxLength": 300
        },
        "notes": {
          "type": "string",
          "description": "Property access or gate preferences.",
          "maxLength": 1000
        },
        "role": {
          "type": "string",
          "enum": ["customer"],
          "description": "Fixed customer role to prevent self-assigned admin elevation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": ["uid", "name", "email", "phone", "role", "createdAt", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator directory entry.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        }
      },
      "required": ["uid", "email", "name", "role"]
    },
    "StaffUser": {
      "title": "StaffUser",
      "description": "Authorized field technician directory entry keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "technicianId": {
          "type": "string",
          "maxLength": 80
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "vehicle": {
          "type": "string",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["technician"]
        }
      },
      "required": ["uid", "email", "name", "role"]
    },
    "BlockedSlot": {
      "title": "BlockedSlot",
      "description": "Unavailable date or time window blocked by administrator dispatch.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "timeSlot": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "date", "timeSlot", "reason", "createdBy", "createdAt"]
    },
    "SlotAvailability": {
      "title": "SlotAvailability",
      "description": "Non-PII shared slot reservation counter used inside Firestore transactions to prevent double-booking.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "timeSlot": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "bookedCount": {
          "type": "integer"
        },
        "appointmentIds": {
          "type": "array"
        },
        "bookedTechIds": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "date", "timeSlot", "bookedCount", "appointmentIds", "bookedTechIds", "updatedAt"]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Publicly readable business hours, contact info, and non-PII dispatch capacity metadata editable by admins.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "hoursSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "daysOpen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "dailyHours": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "hoursNote": {
          "type": "string",
          "maxLength": 500
        },
        "crewCapacity": {
          "type": "integer"
        },
        "dispatchRoster": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "companyName",
        "phone",
        "email",
        "address",
        "hoursSummary",
        "daysOpen",
        "dailyHours",
        "crewCapacity",
        "updatedAt"
      ]
    },
    "QuoteRequest": {
      "title": "QuoteRequest",
      "description": "Customer quote request record linked to authenticated customer UID.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 30
        },
        "serviceId": {
          "type": "string",
          "maxLength": 80
        },
        "serviceName": {
          "type": "string",
          "maxLength": 160
        },
        "propertyAddress": {
          "type": "string",
          "maxLength": 300
        },
        "areaDescription": {
          "type": "string",
          "maxLength": 2000
        },
        "photos": {
          "type": "array",
          "description": "Compressed client-resized JPEG data URLs (max 5 photos)."
        },
        "photoCount": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["new", "reviewed", "quoted", "accepted", "declined"]
        },
        "estimatedPrice": {
          "type": "number"
        },
        "adminNotes": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "customerId",
        "customerName",
        "email",
        "phone",
        "serviceId",
        "serviceName",
        "propertyAddress",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled or historical pressure-washing job tied to an authenticated customer UID.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "customerPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 30
        },
        "serviceId": {
          "type": "string",
          "maxLength": 80
        },
        "serviceName": {
          "type": "string",
          "maxLength": 160
        },
        "serviceAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "scheduledDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "scheduledTime": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "technicianId": {
          "type": "string",
          "maxLength": 80
        },
        "technicianName": {
          "type": "string",
          "maxLength": 120
        },
        "technicianEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "en_route", "in_progress", "completed", "cancelled"]
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "technicianNotes": {
          "type": "string",
          "maxLength": 1000
        },
        "price": {
          "type": "number"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["pending", "invoiced", "paid", "overdue", "refunded"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "customerId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "serviceId",
        "serviceName",
        "serviceAddress",
        "scheduledDate",
        "scheduledTime",
        "technicianId",
        "technicianName",
        "status",
        "price",
        "paymentStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Administrator-recorded payment transaction.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "appointmentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "maxLength": 120
        },
        "amount": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "enum": ["Credit Card", "Check", "Cash", "Bank Transfer", "Online"]
        },
        "status": {
          "type": "string",
          "enum": ["paid", "pending", "refunded"]
        },
        "transactionRef": {
          "type": "string",
          "maxLength": 80
        },
        "date": {
          "type": "string",
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "appointmentId", "customerName", "amount", "method", "status", "transactionRef", "date", "createdAt"]
    },
    "AdminNotification": {
      "title": "AdminNotification",
      "description": "Quote access alerts delivered to administrator inbox.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["quote_access", "system", "message"]
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "customerName": {
          "type": "string",
          "maxLength": 120
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 30
        },
        "serviceName": {
          "type": "string",
          "maxLength": 160
        },
        "propertyAddress": {
          "type": "string",
          "maxLength": 300
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "customerId", "type", "title", "customerName", "customerEmail", "customerPhone", "serviceName", "propertyAddress", "read", "createdAt"]
    },
    "DialogueMessage": {
      "title": "DialogueMessage",
      "description": "Persistent customer-dispatch dialogue record scoped to a customer UID thread and assigned technicians.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "threadId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "maxLength": 120
        },
        "senderRole": {
          "type": "string",
          "enum": ["client", "admin", "technician"]
        },
        "senderName": {
          "type": "string",
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "timestamp": {
          "type": "string",
          "maxLength": 40
        },
        "assignedTechIds": {
          "type": "array",
          "description": "Assigned technician UIDs authorized to view this customer thread."
        },
        "assignedTechEmails": {
          "type": "array",
          "description": "Assigned technician emails authorized to view this customer thread."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "threadId", "customerName", "senderRole", "senderName", "message", "timestamp", "createdAt"]
    },
    "DialogueThreadAccess": {
      "title": "DialogueThreadAccess",
      "description": "Technician access index per customer threadId synchronized on appointment assignment.",
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "assignedTechIds": {
          "type": "array"
        },
        "assignedTechEmails": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["threadId", "assignedTechIds", "assignedTechEmails", "updatedAt"]
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/CustomerProfile" },
      "description": "Private customer profile PII documents keyed by Firebase Auth UID."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized administrator directory keyed by Firebase Auth UID."
    },
    "/staff/{staffId}": {
      "schema": { "$ref": "#/entities/StaffUser" },
      "description": "Authorized field technician directory keyed by Firebase Auth UID."
    },
    "/blockedSlots/{slotId}": {
      "schema": { "$ref": "#/entities/BlockedSlot" },
      "description": "Admin-blocked unavailable dates and arrival windows."
    },
    "/slotAvailability/{slotKey}": {
      "schema": { "$ref": "#/entities/SlotAvailability" },
      "description": "Non-PII shared time-slot reservation state for transactional double-booking prevention."
    },
    "/siteConfig/{configId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Publicly readable business hours, contact info, and non-PII crew roster managed by admins."
    },
    "/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/QuoteRequest" },
      "description": "Customer quote requests isolated by customerId UID."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Appointments and job history isolated by customerId UID or assigned technician."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Admin-only payment transaction ledger."
    },
    "/adminNotifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AdminNotification" },
      "description": "Admin-only quote access alerts."
    },
    "/dialogueMessages/{messageId}": {
      "schema": { "$ref": "#/entities/DialogueMessage" },
      "description": "Customer-dispatch message log scoped to customer UID and assigned technicians."
    },
    "/dialogueThreads/{threadId}": {
      "schema": { "$ref": "#/entities/DialogueThreadAccess" },
      "description": "Technician access list per customer dialogue threadId."
    }
  }
}
